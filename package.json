{
  "name": "vault-app",
  "version": "1.0.0",
  "description": "Long-term memory for AI coding agents: a local web UI and CLI over a folder of Markdown notes, with structured facts and prompt-time recall",
  "private": true,
  "bin": {
    "vault": "bin/vault",
    "vault-recall": "bin/vault-recall",
    "vaultctl": "bin/vaultctl",
    "vault-commit": "bin/vault-commit"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["claude-code", "memory", "llm", "markdown", "obsidian"],
  "author": "Yelzhas Saken",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "marked": "^18.0.13"
  }
}
